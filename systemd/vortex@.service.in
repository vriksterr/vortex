[Unit]
Description=Vortex on %I
After=network.target

[Service]
Type=simple
Restart=always
EnvironmentFile=/etc/vortex/%i/env
ExecStart=@bindir@/vortex-run keyfile /etc/vortex/%i/key $OPTIONS
ExecStartPost=-/etc/vortex/%i/post.sh
CapabilityBoundingSet=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
